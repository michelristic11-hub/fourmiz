{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$gameId": {
        "state": {
          ".read": "auth != null"
        },
        "orders": {
          "$orderId": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.child('uid').val() === auth.uid && newData.child('type').isString() && newData.child('type').val().length <= 10"
          }
        },
        "results": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
